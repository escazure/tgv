#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (binding = 0) uniform sampler2D uHeightMap;
layout (binding = 1, rgba32f) writeonly uniform image2D uNormalMap;

uniform float uTerrainSize;

void main(){
	ivec2 dstCoords =  ivec2(gl_GlobalInvocationID.xy);
	ivec2 resolution = textureSize(uHeightMap, 0);

    if (any(greaterThanEqual(dstCoords, resolution)))
        return;

	ivec2 left  = max(dstCoords - ivec2(1, 0), ivec2(0));
    ivec2 right = min(dstCoords + ivec2(1, 0), resolution - 1);

    ivec2 down  = max(dstCoords - ivec2(0, 1), ivec2(0));
    ivec2 up    = min(dstCoords + ivec2(0, 1), resolution - 1);

	float hL = texelFetch(uHeightMap, left, 0).r;	
	float hR = texelFetch(uHeightMap, right, 0).r;	
	float hU = texelFetch(uHeightMap, up, 0).r;	
	float hD = texelFetch(uHeightMap, down, 0).r;	

	float stepSize = uTerrainSize / float(resolution.x - 1);

	float dx = float(right.x - left.x) * stepSize;
	float dz = float(up.y - down.y) * stepSize;

	vec3 dX = vec3(dx, hR - hL, 0.0);
	vec3 dZ = vec3(0.0, hU - hD, dz);

    vec3 normal = normalize(cross(dZ, dX));
	imageStore(uNormalMap, dstCoords, vec4(normal * 0.5 + 0.5, 1.0));
}
