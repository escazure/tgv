#version 460 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (binding = 0) uniform sampler2D uHeightMap;
layout (binding = 1) uniform sampler2D uNormalMap;
layout (binding = 2, r32f) writeonly uniform image2D uShadowMap;

uniform float uTerrainSize;
uniform float uMaxHeight;
uniform vec3 uLightDir;

const int MAX_STEPS = 1024;
const float BASE_TEXELS_PER_STEP = 2.0;
const float MAX_JUMP_FACTOR = 8.0;
const float SHADOW_SOFTNESS = 8.0;

uvec2 mortonDecode8x8(uint index) {
    uint x = (index & 0x01u) | ((index & 0x04u) >> 1u) | ((index & 0x10u) >> 2u);
    uint y = ((index & 0x02u) >> 1u) | ((index & 0x08u) >> 2u) | ((index & 0x20u) >> 3u);
    return uvec2(x, y);
}

float smin(float a, float b, float k) {
    k *= 4.0;
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * k * 0.25;
}

void main() {
    uvec2 localPos = mortonDecode8x8(gl_LocalInvocationIndex);
    ivec2 dstCoords = ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy + localPos);
    ivec2 imgSize = imageSize(uShadowMap);

    if (dstCoords.x >= imgSize.x || dstCoords.y >= imgSize.y) return;

    vec2 uv = (vec2(dstCoords) + vec2(0.5)) / uTerrainSize;
    float texelSize = 1.0 / uTerrainSize;
    vec3 fragToLight = normalize(-uLightDir);

    float finalShadow = 1.0; // Single shadow accumulator variable

    // Branch structuring eliminates register spills from early returns
    if (fragToLight.y > 0.0) {
        vec3 normal = textureLod(uNormalMap, uv, 0.0).rgb;
        
        if (dot(normal, fragToLight) > 0.0) {
            float horizontalLen = length(fragToLight.xz);
            
            if (horizontalLen >= 0.0001) {
                vec2 uvStep = (fragToLight.xz / horizontalLen) * texelSize * BASE_TEXELS_PER_STEP;
                float worldStepDist = length(uvStep) * uTerrainSize;
                float heightStep = (fragToLight.y / horizontalLen) * worldStepDist;

                // PACK ENTIRE RAY STATE INTO 2 VEC4s FOR 1-CYCLE FMA INSTRUCTIONS
                // currentRay = (uv.x, uv.y, currentHeight, totalDistWorld)
                vec4 currentRay = vec4(uv + (normal.xz * 0.0001) + uvStep, 
                                       textureLod(uHeightMap, uv, 0.0).r + (heightStep * 2.0), 
                                       worldStepDist);
                
                vec4 stepRay = vec4(uvStep, heightStep, worldStepDist);

                for (int i = 0; i < MAX_STEPS; i++) {
                    // Fast vector bounds checks
                    if (any(lessThan(currentRay.xy, vec2(0.0))) || any(greaterThan(currentRay.xy, vec2(1.0)))) break;
                    if (currentRay.z > uMaxHeight) break;

                    float terrainHeight = textureLod(uHeightMap, currentRay.xy, 0.0).r;
                    float diff = currentRay.z - terrainHeight;

                    if (diff < 0.0) {
                        finalShadow = 0.0;
                        break; // Exit loop clean
                    }

                    float stepMultiplier = clamp(1.0 + diff / (BASE_TEXELS_PER_STEP * 2.0), 1.0, MAX_JUMP_FACTOR);
                    finalShadow = smin(finalShadow, SHADOW_SOFTNESS * diff / currentRay.w, 0.1);

                    if (finalShadow < 0.01) {
                        finalShadow = 0.0;
                        break;
                    }

                    // SINGLE VEC4 HARDWARE VECTOR MULTIPLY-ADD (FMA)
                    currentRay += stepRay * stepMultiplier;
                }
            }
        } else {
            finalShadow = 0.0;
        }
    } else {
        finalShadow = 0.0;
    }

    // SINGLE IMAGESTORE FOR THE ENTIRE COMPUTE SHADER
    imageStore(uShadowMap, dstCoords, vec4(clamp(finalShadow, 0.0, 1.0)));
}
