#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (binding = 0) uniform sampler2D uHeightMap;
layout (binding = 1, rgba32f) writeonly uniform image2D uNormalMap;

uniform float uTerrainSize;

void main(){
	ivec2 dstCoords =  ivec2(gl_GlobalInvocationID.xy);
	vec2 uv = vec2(dstCoords) / uTerrainSize;
	float texelSize = 1.0 / uTerrainSize;

	float worldStep = uTerrainSize * texelSize;

	float hL = texture(uHeightMap, uv - vec2(texelSize, 0.0)).r;	
	float hR = texture(uHeightMap, uv + vec2(texelSize, 0.0)).r;	
	float hU = texture(uHeightMap, uv + vec2(0.0, texelSize)).r;	
	float hD = texture(uHeightMap, uv - vec2(0.0, texelSize)).r;	

	vec3 dX = vec3(2.0 * worldStep, hR - hL, 0.0);
    vec3 dY = vec3(0.0, hU - hD, 2.0 * worldStep);

    vec3 normal = normalize(cross(dY, dX));
	
	imageStore(uNormalMap, dstCoords, vec4(normal * 0.5 + 0.5, 1.0));
}
