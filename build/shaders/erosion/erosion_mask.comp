#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (binding = 0) uniform sampler2D uHeightMap;
layout (binding = 1) uniform sampler2D uPreviousMask;
layout (binding = 2, r32f) uniform image2D uErosionMask;

uniform float uTerrainSize;
uniform int uIteration;

const float EROSION_STRENGTH = 20.0;
const float THERMAL_STRENGTH = 0.1;

void main(){
	ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
	float texelSize = 1.0 / uTerrainSize;

	float hC = texelFetch(uHeightMap, coords, 0).r;
	float hL = texelFetch(uHeightMap, coords - ivec2(1, 0), 0).r;
	float hR = texelFetch(uHeightMap, coords + ivec2(1, 0), 0).r;
	float hU = texelFetch(uHeightMap, coords + ivec2(0, 1), 0).r;
	float hD = texelFetch(uHeightMap, coords - ivec2(0, 1), 0).r;

	vec2 gradient = vec2(hR - hL, hU - hD) * 0.5;
	float slope = length(gradient);
	float slopeSquared = dot(gradient, gradient);

	float erosion = 1.0 - pow(1.0 / (1.0 + slopeSquared * EROSION_STRENGTH), 3.0);

	float dropL = hC - hL;
	float dropR = hC - hR;
	float dropU = hC - hU;
	float dropD = hC - hD;

	float downhill = max(max(dropL, dropR), max(dropU, dropD));
	float gully = erosion * smoothstep(0.005, 0.05, downhill);

	float thermal = smoothstep(0.01, 0.04, slope) * THERMAL_STRENGTH;

	float previousMask = 0.0;
	if(uIteration > 0){
		previousMask = texelFetch(uPreviousMask, coords, 0).r;
	}
	float finalMask = previousMask + gully + thermal;

	imageStore(uErosionMask, coords, vec4(finalMask, 0.0, 0.0, 0.0));
}
